{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/contact",
      "has": [
        {
          "type": "query",
          "key": "utm_source",
          "value": "kozijnwrap.nl"
        },
        {
          "type": "query",
          "key": "utm_campaign",
          "value": "herstel-zakelijk"
        }
      ],
      "destination": "/vve-en-woningcorporaties",
      "permanent": false
    },
    {
      "source": "/contact",
      "has": [
        {
          "type": "query",
          "key": "utm_source",
          "value": "kozijnwrap.nl"
        },
        {
          "type": "query",
          "key": "utm_medium",
          "value": "keuzehulp"
        }
      ],
      "destination": "/offerte",
      "permanent": false
    },
    {
      "source": "/contact",
      "has": [
        {
          "type": "query",
          "key": "utm_source",
          "value": "kozijnwrap.nl"
        },
        {
          "type": "query",
          "key": "utm_medium",
          "value": "partybox"
        }
      ],
      "destination": "/offerte",
      "permanent": false
    },
    {
      "source": "/contact",
      "has": [
        {
          "type": "query",
          "key": "utm_source",
          "value": "houtnerffolie"
        },
        {
          "type": "query",
          "key": "utm_content",
          "value": "cta"
        }
      ],
      "destination": "/offerte",
      "permanent": false
    },
    {
      "source": "/kunststof-kozijnen-herstellen",
      "destination": "/kunststof-kozijn-herstellen",
      "permanent": true
    },
    {
      "source": "/kozijnherstel",
      "destination": "/kunststof-kozijn-herstellen",
      "permanent": true
    },
    {
      "source": "/over-ons",
      "destination": "/over-iwrap",
      "permanent": true
    },
    {
      "source": "/offerte-aanvragen",
      "destination": "/offerte",
      "permanent": true
    },
    {
      "source": "/prijzen",
      "destination": "/kosten",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/veelgestelde-vragen",
      "permanent": true
    },
    {
      "source": "/kozijnen-herstellen",
      "destination": "/kunststof-kozijn-herstellen",
      "permanent": true
    },
    {
      "source": "/kozijnen-restylen",
      "destination": "/kunststof-kozijn-herstellen",
      "permanent": true
    },
    {
      "source": "/devoordelen",
      "destination": "/kunststof-kozijn-herstellen",
      "permanent": true
    },
    {
      "source": "/projecten",
      "destination": "/voorbeelden",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "/voorbeelden",
      "permanent": true
    },
    {
      "source": "/portfolio/:pad*",
      "destination": "/voorbeelden",
      "permanent": true
    },
    {
      "source": "/portfolio_cat/:pad*",
      "destination": "/voorbeelden",
      "permanent": true
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/page-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/wp-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/resultaten",
      "destination": "/voorbeelden",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/r/:id",
      "destination": "/rapport"
    },
    {
      "source": "/api/:pad*",
      "destination": "/api/index?pad=:pad*"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{images/**,media/**,kozijnhorren/**,src/**,css/**,js/**,kozijnmerken/**,tests/**,.data/**,prive/**,*.html,*.xml,*.md}"
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 7 * * *"
    }
  ]
}
