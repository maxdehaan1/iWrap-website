{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/kunststof-kozijnen-herstellen", "destination": "/kunststof-kozijn-herstellen", "permanent": true },
    { "source": "/kozijnherstel", "destination": "/kunststof-kozijn-herstellen", "permanent": true },
    { "source": "/over-ons", "destination": "/over-iwrap", "permanent": true },
    { "source": "/offerte-aanvragen", "destination": "/offerte", "permanent": true },
    { "source": "/prijzen", "destination": "/kosten", "permanent": true },
    { "source": "/faq", "destination": "/veelgestelde-vragen", "permanent": true }
  ]
}
